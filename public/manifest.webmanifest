{
  "name": "Kakeibo – Expense tracker",
  "short_name": "Kakeibo",
  "description": "Scan Japanese receipts and track spending by day and month.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f5f4f0",
  "theme_color": "#2c7a74",
  "share_target": {
    "action": "/share-email",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "email", "accept": ["message/rfc822", ".eml"] }] }
  },
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
